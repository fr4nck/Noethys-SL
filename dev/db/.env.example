# Recette jetable uniquement. Ne jamais utiliser des donnees de production.
# Copier vers dev/db/.env (ignore de Git), puis changer les mots de passe.
# Le nom de la base et le port sont fixes par guard.ps1.
NOETHYS_DB_ROOT_PASSWORD=CHANGE_ME_ROOT_LONG_RANDOM
NOETHYS_DB_NAME=noethys_dev
NOETHYS_DB_USER=noethys
NOETHYS_DB_PASSWORD=CHANGE_ME_USER_LONG_RANDOM
NOETHYS_DB_PORT=3308
